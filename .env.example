# ===== មូលដ្ឋានទិន្នន័យ MongoDB =====
# ទទួលបាន Connection String ពី MongoDB Atlas (ឥតគិតថ្លៃ):
# 1. ចូលទៅ https://www.mongodb.com/atlas → Create Free Account
# 2. បង្កើត Cluster (Free Tier M0)
# 3. ចុច "Connect" → "Connect your application" → ចម្លង connection string
# ជំនួស <username>, <password>, <cluster-name> ដោយព័ត៌មានរបស់អ្នក
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/makara_store?retryWrites=true&w=majority"

# ===== NextAuth.js =====
# NEXTAUTH_URL: URL របស់គេហទំព័រអ្នក (localhost សម្រាប់ development)
NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET: បង្កើតដោយប្រើ: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"

# ===== Google OAuth 2.0 =====
# ទទួលបានពី: https://console.cloud.google.com/apis/credentials
# 1. បង្កើត Project → OAuth consent screen → External
# 2. Create Credentials → OAuth client ID → Web application
# 3. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===== Apple OAuth =====
# ទទួលបានពី: https://developer.apple.com/account/resources/identifiers
# ត្រូវការ Apple Developer Account ($99/year)
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
