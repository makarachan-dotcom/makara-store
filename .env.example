# ===== Database (MongoDB Atlas) =====
# Get from: https://www.mongodb.com/atlas (Free Tier M0)
# 1. Create Account → Create Cluster (Free M0)
# 2. Click "Connect" → "Connect your application" → Copy connection string
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/makara_store?retryWrites=true&w=majority"

# ===== NextAuth.js =====
# NEXTAUTH_URL: Your site URL (localhost for development)
NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET: Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"

# ===== Google OAuth 2.0 =====
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create Project → OAuth consent screen → External
# 2. Create Credentials → OAuth client ID → Web application
# 3. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===== Bakong KHQR (Cambodia Payment) =====
# Register at: https://api-bakong.nbc.gov.kh/
# Sandbox: https://sit-api-bakong.nbc.gov.kh/
# Alternative (easier): https://camrapidpay.com/ (0.10% fee)
BAKONG_API_URL="https://sit-api-bakong.nbc.gov.kh"
BAKONG_BEARER_TOKEN=""
BAKONG_MERCHANT_NAME="MAKARA STORE"
BAKONG_MERCHANT_CITY="PHNOM PENH"
BAKONG_ACCOUNT_ID="yourname@aba"
BAKONG_MERCHANT_ID="MAKARA"
BAKONG_ACQUIRING_BANK="ABA Bank"

# ===== Stripe (International Card Payment) =====
# Register at: https://stripe.com (use Singapore address)
# Dashboard → Developers → API Keys
# Enable: Visa, Mastercard, UnionPay only
# Fee: 2.9% + $0.30 per transaction
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ===== Telegram Bot (Admin Notifications) =====
# 1. Message @BotFather on Telegram → /newbot
# 2. Get bot token
# 3. Message @userinfobot to get your Chat ID
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# ===== Cloudflare R2 (Receipt Image Storage) =====
# Register at: https://dash.cloudflare.com (Free: 10GB/month)
# Create R2 bucket: makara-store-receipts
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="makara-store-receipts"
R2_ENDPOINT=""

# ===== JWT =====
# Generate with: openssl rand -base64 64
JWT_SECRET=""

# ===== App =====
NEXT_PUBLIC_APP_URL="https://makara-store.vercel.app"
NODE_ENV="development"
